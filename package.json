{
  "name": "dear-to-love",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "set-version": "node scripts/set-version.mjs",
    "test:scripts": "node --test scripts/versions.test.mjs scripts/smoke/report.test.mjs",
    "gen:types": "cd src-tauri && cargo test --lib export_bindings && cd .. && node scripts/gen-types-index.mjs",
    "gen:types-index": "node scripts/gen-types-index.mjs",
    "e2e": "node --test --test-concurrency=1 e2e/smoke.test.mjs e2e/live.test.mjs e2e/ollama.test.mjs e2e/wizard.test.mjs e2e/editor.test.mjs e2e/images.test.mjs e2e/storypack.test.mjs e2e/backups.test.mjs e2e/search.test.mjs e2e/updates.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "webdriverio": "^10.2.0"
  }
}
